{
  "name": "telegramreport",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:api": "node apps/api/index.js",
    "dev:bot": "node apps/bot/timekeep_bot.js",
    "dev:web": "cd apps/web-admin && npm run build",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:bot\"",
    "test:kpi-memberships": "node packages/database/test_kpi_memberships.js",
    "test:kpi-membership-api": "node packages/database/test_kpi_membership_api.js",
    "test:warehouse-module": "node --experimental-test-isolation=none --test domains/warehouse/tests/warehouse.module.test.js",
    "test:warehouse-admin": "node --experimental-test-isolation=none --test domains/warehouse/tests/warehouse-admin.test.js",
    "test:warehouse-admin-ui": "node --experimental-test-isolation=none --test apps/web-admin/src/WarehouseManagement.test.js",
    "test:warehouse-admin-db": "node --experimental-test-isolation=none --test domains/warehouse/tests/warehouse-admin.integration.test.js",
    "test:warehouse-domain": "node --experimental-test-isolation=none --test domains/warehouse/tests/warehouse-domain.test.js",
    "test:warehouse-db": "node --experimental-test-isolation=none --test domains/warehouse/tests/warehouse-order.integration.test.js",
    "test:warehouse-import-db": "node --experimental-test-isolation=none --test domains/warehouse/tests/warehouse-import.integration.test.js",
    "test:warehouse-sheet": "node --experimental-test-isolation=none --test domains/warehouse/tests/service-order-sheet-sync.test.js",
    "test:warehouse-miniapp": "node --experimental-test-isolation=none --test domains/warehouse/tests/warehouse-miniapp.test.js",
    "test:warehouse-all": "npm run check:warehouse && npm run test:warehouse-miniapp && npm run test:warehouse-db && npm run test:warehouse-import-db && npm run test:warehouse-sheet && npm run test:warehouse-admin-db && npm run verify:warehouse-v19 && npm run test:kpi-memberships && npm run test:kpi-membership-api",
    "check:warehouse": "node --check apps/bot/timekeep_bot.js && node --check apps/api/index.js && npm run test:warehouse-architecture && npm run test:warehouse-domain && npm run test:warehouse-module && npm run test:warehouse-admin && npm run test:warehouse-admin-ui",
    "migrate:warehouse-v19": "node packages/database/run_migrations_v19.js",
    "verify:warehouse-v19": "node packages/database/verify_warehouse_v19.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:warehouse-architecture": "node --experimental-test-isolation=none --test domains/warehouse/tests/architecture.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.7.0",
    "google-spreadsheet": "^5.3.0",
    "googleapis": "^173.0.0",
    "imghash": "^1.1.4",
    "jimp": "^1.6.1",
    "moment": "^2.30.1",
    "multer": "^2.2.0",
    "node-cron": "^4.4.1",
    "pg": "^8.22.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14"
  },
  "type": "module"
}
